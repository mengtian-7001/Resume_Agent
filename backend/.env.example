SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
INTERNAL_API_TOKEN=replace-with-a-long-random-token
ALLOWED_ORIGINS=http://localhost:4173

# Start with mock mode to run the full workflow without model credentials.
AGENT_MODE=mock

# Configure these when switching to an OpenAI-compatible real model.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional in mock mode. When configured, verified facts are mirrored to Neo4j.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Optional. Used by the JD Research ReAct when real web search is enabled.
TAVILY_API_KEY=
