SUPABASE_URL=https://your-project.supabase.co
# Browser-safe Supabase connection values used to generate supabase-config.js
# during a Vercel build. Prefer the newer publishable key when available.
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
SUPABASE_WORKSPACE_ID=replace-with-workspace-uuid
ALLOW_ANONYMOUS_BOOTSTRAP=false

# Server-only secrets. Never expose these in frontend code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
INTERNAL_API_TOKEN=replace-with-a-long-random-token
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:4174,http://127.0.0.1:4173,http://127.0.0.1:4174,http://127.0.0.1:4175

# mock = 本地规则；openai = 调用真实模型（需填写下面两套 Agent 配置）
AGENT_MODE=mock
AUTO_PROCESS_QUEUE=false

# ---------- 可选：两套 Agent 共用的兜底 ----------
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Agent 1：Construction（匹配 / 面试题）----------
CONSTRUCTION_OPENAI_BASE_URL=
CONSTRUCTION_OPENAI_API_KEY=
CONSTRUCTION_MODEL=

# ---------- Agent 2：Checker（质检）----------
CHECKER_OPENAI_BASE_URL=
CHECKER_OPENAI_API_KEY=
CHECKER_MODEL=

# Optional in mock mode. When configured, verified facts are mirrored to Neo4j.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Optional. Used by the JD Research ReAct when real web search is enabled.
TAVILY_API_KEY=

# Optional. Embedding model for /embeddings (never reuse a chat model name).
EMBEDDING_MODEL=text-embedding-3-small

# ReAct / fan-out / embeddings
# Tool-loop steps should cover score→memory→skills→web→judge→questions.
AGENT_MAX_REACT_STEPS=8
# Max Construction LLM chat calls per candidate (judge/retry/reflect/questions).
AGENT_MAX_LLM_CALLS=6
# Global LLM concurrency / circuit / job wall-clock deadline (seconds).
LLM_MAX_CONCURRENT=4
LLM_CIRCUIT_FAIL_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN_SEC=30
JOB_DEADLINE_SEC=280
# Lease must exceed the deadline; Worker renews it every ≤45 seconds.
TASK_LEASE_SEC=300
FANOUT_WORKERS=4
CHECKER_FAIL_CLOSED=true
AGENT_LLM_REFLECT=true
